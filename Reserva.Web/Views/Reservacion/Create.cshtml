@model Reserva.Web.ViewModels.ReservacionViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Crear Reservación";
}

<div class="container mt-4">
    <h2 class="text-white mb-4">Crear Reservación</h2>

    <div class="row">
        <!-- Formulario principal -->
        <div class="col-md-8">
            <div class="p-4 rounded-4" style="background: linear-gradient(135deg, #0A1931, #185ADB); color: white;">
                <form asp-action="Create" method="post" id="formReservacion">
                    <div class="row g-4">
                        <!-- Selección de Fecha y Crucero -->
                        <div class="col-md-6">
                            <label for="IdFecha" class="form-label fw-bold">Crucero y Fecha</label>
                            <select id="IdFecha" name="IdFecha" class="form-select shadow-sm">
                                <option value="">Seleccione una fecha</option>
                                @foreach (var fecha in Model.FechasDisponibles)
                                {
                                    var fechaObj = Model.Fechas.FirstOrDefault(f => f.IdFecha.ToString() == fecha.Value);
                                    if (fechaObj != null)
                                    {
                                        <option value="@fecha.Value"
                                                data-idcrucero="@fechaObj.IdCrucero"
                                                data-fechasalida="@fechaObj.FechaSalida.ToString("yyyy-MM-dd")">
                                            @fecha.Text
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Selección de Itinerario -->
                        <div class="col-md-6">
                            <label for="IdItinerario" class="form-label fw-bold">Itinerario</label>
                            <select asp-for="IdItinerario" id="IdItinerario" class="form-select shadow-sm">
                                <option value="">Seleccione uno</option>
                            </select>
                        </div>
                    </div>

                    <!-- Habitaciones -->
                    <div class="mt-4">
                        <div class="card shadow-sm border-0" style="background-color: #1B1B2F; color: white;">
                            <div class="card-header bg-info text-white fw-bold">
                                Habitaciones Disponibles
                            </div>
                            <div class="card-body">
                                <div class="table-responsive rounded-3 shadow">
                                    <table class="table table-dark table-bordered">
                                        <thead class="table-secondary text-center">
                                            <tr>
                                                <th>Seleccionar</th>
                                                <th>Nombre</th>
                                                <th>Precio</th>
                                            </tr>
                                        </thead>
                                        <tbody id="habitacionesContainer"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Huéspedes -->
                    <div class="row mt-4 g-4">
                        <div class="col-md-12">
                            <div class="card shadow-sm border-0" style="background-color: #1B1B2F; color: white;">
                                <div class="card-header bg-info text-white fw-bold">
                                    Huéspedes
                                </div>
                                <div class="card-body d-flex flex-column gap-3" id="huespedesContainer">
                                    @if (Model.Huespedes.Any())
                                    {
                                        <partial name="_HuespedesForm" for="@Model.Huespedes[0]" />
                                    }
                                    <button type="button" class="btn fw-bold text-dark mt-2" id="btnAgregarHuesped" style="background-color: #FFC947;">
                                        + Agregar otro huésped
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Complementos -->
                    <div class="row mt-4 g-4">
                        <div class="col-md-12">
                            <div class="card shadow-sm border-0" style="background-color: #1B1B2F; color: white;">
                                <div class="card-header bg-info text-white fw-bold">
                                    Complementos
                                </div>
                                <div class="card-body d-flex flex-column gap-3">
                                    <div class="form-group mb-2">
                                        <label for="complementoSelector" class="fw-semibold">Seleccionar complemento</label>
                                        <select id="complementoSelector" class="form-select">
                                            <option value="">-- Seleccione --</option>
                                            @for (int i = 0; i < Model.Complementos.Count; i++)
                                            {
                                                <option value="@Model.Complementos[i].IdComplemento"
                                                        data-nombre="@Model.Complementos[i].Nombre"
                                                        data-precio="@Model.Complementos[i].Precio"
                                                        data-tipo="@Model.Complementos[i].Tipo">
                                                    @Model.Complementos[i].Nombre (@Model.Complementos[i].Precio.ToString("C", new CultureInfo("es-CR")))
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <button type="button" class="btn fw-bold text-dark" id="btnAgregarComplemento" style="background-color: #FFC947;">
                                        + Agregar complemento
                                    </button>

                                    <div id="complementosContainer" class="mt-3">
                                        @for (int i = 0; i < Model.Complementos.Count; i++)
                                        {
                                            if (Model.Complementos[i].Cantidad > 0)
                                            {
                                                <partial name="_ComplementoForm" for="@Model.Complementos[i]" />
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Panel lateral de resumen -->
        <div class="col-md-4">
            <div id="resumenContainer" class="sticky-top mt-2 p-2 rounded-4 border border-light text-black" style="background-color: #1B1B2F; border-width: 1px;;">
                @await Html.PartialAsync("_ResumenReserva", Model.Resumen)
            </div>
        </div>
    </div>
</div>


@section Scripts {


    <script>
        function actualizarResumen() {
            const resumen = {
                nombreCrucero: document.querySelector("#IdFecha option:checked")?.textContent.trim() || "Crucero no seleccionado",
                puertoSalida: window.puertoSalida || "",
                puertoRegreso: window.puertoRegreso || "",
                fechaInicio: "2025-06-01",
                fechaFin: "2025-06-07",
                habitaciones: [],
                complementos: []
            };

            document.getElementById("IdItinerario").addEventListener("change", function () {
            const idItinerario = this.value;

            fetch(`/Itinerario/ObtenerPuertos?idItinerario=${idItinerario}`)
                .then(r => r.json())
                .then(data => {
                    window.puertoSalida = data.puertoSalida;
                    window.puertoRegreso = data.puertoRegreso;

                    actualizarResumen();
                });
            });

            // Habitaciones seleccionadas
            document.querySelectorAll("input[name='HabitacionesSeleccionadas']:checked").forEach(chk => {
                const row = chk.closest("tr");
                const nombre = row.querySelector("td:nth-child(2)").textContent.trim();
                const precioStr = row.querySelector("td:nth-child(3)").textContent.replace(/[^\d,.-]/g, "").replace(",", ".")
                const precio = parseFloat(precioStr.replace(/[^\d.-]/g, '').replace(",", ".")) || 0;

                resumen.habitaciones.push({
                    nombre: nombre,
                    cantidadHuespedes: 2, // puedes conectar esto luego con datos reales
                    precio: precio
                });
            });

            // Complementos agregados
            document.querySelectorAll(".complemento-item").forEach(c => {
                const nombre = c.querySelector("input[name*='Nombre']").value;
                const tipo = c.querySelector("input[name*='Tipo']").value;
                const cantidad = parseInt(c.querySelector("input[name*='Cantidad']").value) || 0;
                const precio = parseFloat(c.querySelector("input[name*='Precio']").value) || 0;

                resumen.complementos.push({
                    nombre: nombre,
                    tipo: tipo,
                    cantidad: cantidad,
                    precioUnitario: precio
                });
            });

            // Enviar y actualizar el resumen parcial
            fetch("/Reservacion/ActualizarResumen", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(resumen)
            })
            .then(res => res.text())
            .then(html => {
                document.getElementById("resumenContainer").innerHTML = html;
            });
        }

        // Lanzar actualización al hacer cambios
        document.addEventListener("change", function (e) {
            const targets = [
                "input[name='HabitacionesSeleccionadas']",
                "input[name*='Cantidad']",
                "#IdFecha",
                "#IdItinerario"
            ];

            if (targets.some(sel => e.target.matches(sel))) {
                actualizarResumen();
            }
        });
    </script>



    <script>
        document.getElementById("IdFecha").addEventListener("change", function () {
            const idFecha = this.value;

            fetch(`/Reservacion/GetHabitacionesPorFecha?idFecha=${idFecha}`)
                .then(response => response.json())
                .then(data => {
                    const contenedor = document.getElementById("habitacionesContainer");
                    contenedor.innerHTML = "";

                    data.forEach(h => {
                        const row = document.createElement("tr");
                        row.innerHTML = `
                            <td>
                                <input type="checkbox" name="HabitacionesSeleccionadas" value="${h.id}" />
                            </td>
                            <td>${h.nombre}</td>
                            <td>${h.precio}</td>
                        `;
                        contenedor.appendChild(row);
                    });
                });
        });
    </script>

    <script>
        document.getElementById("IdFecha").addEventListener("change", function () {
            const selectedOption = this.options[this.selectedIndex];
            const idCrucero = selectedOption.getAttribute("data-idcrucero");
            const fechaSalida = selectedOption.getAttribute("data-fechasalida");

            const itinerarioSelect = document.getElementById("IdItinerario");
            itinerarioSelect.innerHTML = '<option value="">Cargando itinerarios...</option>';

            if (!idCrucero || !fechaSalida) {
                itinerarioSelect.innerHTML = '<option value="">Seleccione uno</option>';
                return;
            }

            fetch(`/Reservacion/GetItinerariosPorCrucero?idCrucero=${idCrucero}&fechaSalidaStr=${fechaSalida}`)
                .then(res => res.json())
                .then(data => {
                    itinerarioSelect.innerHTML = '<option value="">Seleccione uno</option>';
                    data.forEach(i => {
                        const option = document.createElement("option");
                        option.value = i.id;
                        option.textContent = `${i.nombre} - ${i.duracion} días - Regreso: ${i.fechaRegreso}`;
                        itinerarioSelect.appendChild(option);
                    });
                });
        });
    </script>

    <script>
        let contadorHuespedes = @Model.Huespedes.Count;

        document.getElementById("btnAgregarHuesped").addEventListener("click", function () {
            fetch(`/Reservacion/RenderHuespedPartial?index=${contadorHuespedes}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById("huespedesContainer").insertAdjacentHTML("beforeend", html);
                    contadorHuespedes++;
                });
        });

        document.getElementById("huespedesContainer").addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("btn-quitar-huesped")) {
                const bloque = e.target.closest(".huesped-item");
                if (bloque) bloque.remove();
            }
        });
    </script>

    <script>
        let contadorComplementos = @Model.Complementos.Count;

        document.getElementById("btnAgregarComplemento").addEventListener("click", function () {
            const selector = document.getElementById("complementoSelector");
            const selectedOption = selector.options[selector.selectedIndex];
            const id = selector.value;

            if (!id) return;

            const yaAgregado = document.querySelector(`input[name^='Complementos'][value='${id}']`);
            if (yaAgregado) {
                alert("Este complemento ya fue agregado.");
                return;
            }

            // Tomamos los datos desde los atributos del option seleccionado
            const nombre = selectedOption.getAttribute("data-nombre");
            const precioRaw = selectedOption.getAttribute("data-precio");
            const precio = precioRaw.replace(",", "."); // fuerza punto decimal
            const tipo = selectedOption.getAttribute("data-tipo");

            // Llamamos al servidor y le pasamos todo por querystring
            fetch(`/Reservacion/RenderComplementoPartial?index=${contadorComplementos}&idComplemento=${id}&nombre=${encodeURIComponent(nombre)}&precio=${precio}&tipo=${tipo}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById("complementosContainer").insertAdjacentHTML("beforeend", html);
                    contadorComplementos++;
                    selector.selectedIndex = 0;
                });
        });

        document.getElementById("complementosContainer").addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("btn-quitar-complemento")) {
                const bloque = e.target.closest(".complemento-item");
                if (bloque) bloque.remove();
            }
        });
    </script>

}

