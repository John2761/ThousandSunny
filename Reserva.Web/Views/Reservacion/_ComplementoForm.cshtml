@{
    var index = ViewData["Index"];
}
@model Reserva.Web.ViewModels.ComplementoSeleccionadoViewModel

<div class="border rounded p-3 mb-3 complemento-item" data-complemento-index="@index">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">@Model.Nombre</h5>
        <button type="button" class="btn btn-sm btn-danger btn-quitar-complemento">
            Quitar
        </button>
    </div>

    <div class="form-group">
        <label>Precio</label>
        <input type="text" class="form-control" value="@Model.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))" readonly />
    </div>

    <div class="form-group">
        <label>Cantidad</label>
        <input name="Complementos[@index].Cantidad" class="form-control" type="number" min="0" max="@(Model.Tipo ? 1 : 10)" />
    </div>

    <input type="hidden" name="Complementos[@index].IdComplemento" value="@Model.IdComplemento" />
    <input type="hidden" name="Complementos[@index].Nombre" value="@Model.Nombre" />
    <input type="hidden" name="Complementos[@index].Tipo" value="@Model.Tipo.ToString().ToLower()" />
    <input type="hidden" name="Complementos[@index].Precio" value="@Model.Precio" />
</div>
