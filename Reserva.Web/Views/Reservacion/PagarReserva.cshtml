@model Reserva.Web.ViewModels.PagoViewModel
@{
    ViewData["Title"] = "Pagar Reserva";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="p-4 rounded-4" style="background: linear-gradient(135deg, #0A1931, #185ADB); color: white;">
                <h3 class="mb-4 text-warning">Pagar Reserva</h3>

                <form asp-action="Pagar" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Usuario</label>
                        <input type="text" class="form-control" value="@Model.NombreUsuario" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo Electrónico</label>
                        <input type="email" class="form-control" value="@Model.CorreoUsuario" readonly />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Tipo de Pago</label><br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TipoPago" value="Total" checked />
                            <label class="form-check-label">Pago Total - @Model.TotalReserva.ToString("C", new System.Globalization.CultureInfo("es-CR"))</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TipoPago" value="Deposito" />
                            <label class="form-check-label">
                                Depósito - @Model.MontoDeposito.ToString("C", new System.Globalization.CultureInfo("es-CR"))
                                (Pagar el resto antes del @Model.FechaLimitePago.ToString("yyyy-MM-dd"))
                            </label>
                        </div>
                    </div>

                    <hr class="text-white" />
                    <h5 class="text-white">Detalles de la Tarjeta</h5>

                    <div class="mb-3">
                        <label class="form-label">Número de Tarjeta</label>
                        <input asp-for="NumeroTarjeta" class="form-control" maxlength="16" placeholder="0000 0000 0000 0000" />
                        <span asp-validation-for="NumeroTarjeta" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Fecha de Expiración</label>
                            <input asp-for="FechaExpiracion" class="form-control" placeholder="MM/AA" />
                            <span asp-validation-for="FechaExpiracion" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CVV</label>
                            <input asp-for="CVV" class="form-control" maxlength="4" placeholder="123" />
                            <span asp-validation-for="CVV" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre del Titular</label>
                        <input asp-for="NombreTitular" class="form-control" placeholder="Nombre como aparece en la tarjeta" />
                        <span asp-validation-for="NombreTitular" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn fw-bold text-dark" style="background-color: #FFC947;">
                        Confirmar Pago
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
