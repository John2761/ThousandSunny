@model IEnumerable<Reserva.Application.DTOs.ReservacionDTO>

@{
    ViewData["Title"] = "Index";
}

<h2 class="text-center mt-4">Historial de Reservaciones</h2>

<div class="container mt-3">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th># Reserva</th>
                <th>Crucero</th>
                <th>Fecha de Reserva</th>
                <th>Estado de Pago</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservacion in Model)
            {
                <tr>
                    <td>@reservacion.idReservacion</td>
                    <td>@reservacion.NombreCrucero</td>
                    <td>@reservacion.FechaReserva.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (reservacion.EstadoPago == "Pendiente")
                        {
                            <span class="badge bg-danger">Pendiente</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Pagado</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@reservacion.idReservacion" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye"></i> Ver Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
