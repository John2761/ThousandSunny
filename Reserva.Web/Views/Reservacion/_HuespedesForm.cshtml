@{
    var index = ViewData["Index"];
}
@model Reserva.Web.ViewModels.HuespedInputModel

<div class="border rounded p-3 mb-3 huesped-item">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Huésped</h5>
        <button type="button" class="btn btn-sm btn-danger btn-quitar-huesped">Quitar</button>
    </div>

    <div class="form-group">
        <label>Nombre</label>
        <input name="Huespedes[@index].Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label>Apellidos</label>
        <input name="Huespedes[@index].Apellido" class="form-control" />
    </div>
    <div class="form-group">
        <label>Teléfono</label>
        <input name="Huespedes[@index].Telefono" class="form-control" />
    </div>
    <div class="form-group">
        <label>Edad</label>
        <input name="Huespedes[@index].Edad" type="number" class="form-control" />
    </div>
</div>

