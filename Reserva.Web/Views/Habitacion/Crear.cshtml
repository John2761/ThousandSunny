@model Reserva.Application.DTOs.HabitacionDTO
@using Reserva.Web.Util

@{
    ViewData["Title"] = "Crear Habitación";
}

<div class="container mt-5">
    <div class="header-bg">
        <h2>🛏️ Registrar Nueva Habitación</h2>
    </div>

    <div class="mt-4">
        <div class="form-card">
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            <form id="formHabitacion" asp-action="Crear" method="post">
                <div class="row">
                    <!-- Columna Izquierda -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold text-primary">Nombre</label>
                            <input id="Nombre" asp-for="Nombre" class="form-control" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-bold text-primary">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Columna Derecha -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Tamaño" class="form-label fw-bold text-primary">Tamaño</label>
                            <select asp-for="Tamaño" class="form-select" required>
                                <option value="">Seleccione un tamaño</option>
                                <option value="Pequeña">Pequeña</option>
                                <option value="Mediana">Mediana</option>
                                <option value="Grande">Grande</option>
                                <option value="Extra Grande">Extra Grande</option>
                            </select>
                            <span asp-validation-for="Tamaño" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HuespedesMin" class="form-label fw-bold text-primary">Huéspedes Mínimos</label>
                            <input asp-for="HuespedesMin" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="HuespedesMin" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HuespedesMax" class="form-label fw-bold text-primary">Huéspedes Máximos</label>
                            <input asp-for="HuespedesMax" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="HuespedesMax" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-action="Index" class="btn btn-cancel">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    <button type="submit" id="btnGuardar" class="btn btn-gradient">
                        <i class="bi bi-check-circle"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.SweetAlertMessage))
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @Html.Raw(ViewBag.SuccessMessage)
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        $("#btnGuardar").click(function (event) {
            event.preventDefault(); // Evita el envío inmediato del formulario

            let nombre = $("#Nombre").val().trim();

            if (nombre === "") {
                Swal.fire("Error", "El nombre de la habitación no puede estar vacío", "error");
                return;
            }

            // Verificar si el nombre ya existe en la base de datos
            $.ajax({
                url: "/Habitacion/VerificarNombreUnico",
                type: "GET",
                data: { nombre: nombre },
                success: function (data) {
                    if (data.existe) {
                        Swal.fire("Error", "El nombre de la habitación ya está en uso", "error");
                    } else {
                        $("#formHabitacion").submit(); // Enviar el formulario si el nombre no existe
                    }
                },
                error: function () {
                    Swal.fire("Error", "No se pudo verificar el nombre. Intente nuevamente.", "error");
                }
            });
        });
    });
</script>
