@model IEnumerable<Reserva.Application.DTOs.CruceroDTO>

@{
    ViewData["Title"] = "Lista de Cruceros";

    // Asignar imágenes manualmente según el nombre del crucero
    var imagesCrucero = new Dictionary<string, string>
    {
        { "Aventura Caribeña", "artico.jpg" },
        { "Tesoros del Caribe", "caribe.jpg" },
        { "Islas del Paraíso", "caribeña.jpg" },
        { "Ruta Maya", "maya.jpg" },
        { "Explorador Tropical", "tropical.jpg" }
    };
}

<!-- Mostrar mensaje de éxito si existe -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="text-center mt-4">Explora Nuestros Cruceros</h2>

<!-- Botón para Crear Nuevo Crucero -->
<div class="text-center mb-4">
    <a asp-action="Crear" class="btn btn-success">+ Crear Nuevo Crucero</a>
</div>



<div class="container">
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var crucero in Model)
        {
            var imagenUrl = imagesCrucero.ContainsKey(crucero.Nombre)
            ? Url.Content($"~/images/crucero/{imagesCrucero[crucero.Nombre]}")
            : Url.Content("~/images/crucero/default.jpg"); // Imagen por defecto

            <div class="col">
                <div class="card shadow-lg border-0 rounded-4 h-100">
                    <img src="@imagenUrl" class="card-img-top" alt="@crucero.Nombre" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-uppercase fw-bold text-primary">@crucero.Nombre</h5>
                        <p class="card-text"><strong>Duración:</strong> @crucero.CantidadDias días</p>
                        <p class="card-text"><strong>Barco:</strong> @crucero.NombreBarco</p>
                        <div class="mt-auto text-center">
                            <a asp-action="Detalle" asp-route-id="@crucero.IdCrucero" class="btn btn-primary w-100">
                                <i class="bi bi-eye"></i> Ver Detalle
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
   
</div>
