@model IEnumerable<Reserva.Application.DTOs.BarcoDTO>

@{
    ViewData["Title"] = "Lista de Barcos";

    // Diccionario para asignar imágenes según el nombre del barco
    var imagesBarco = new Dictionary<string, string>
    {
        { "Mar del Caribe", "~/images/barco/MCaribe.jpg" },
        { "Blue Island", "~/images/barco/blue.jpg" },
        { "Ocean Explorer", "~/images/barco/ocean.jpg" },
        { "Pacific Dream", "~/images/barco/pacific.jpg" },
        { "Atlantis Voyager", "~/images/barco/Atlantis.jpg" }
    };
}

<h2 class="text-center mt-4">Explora Nuestros Barcos</h2>
<a asp-controller="Barco" asp-action="Create" class="btn btn-primary w-100">
    <i class="bi bi-eye"></i> Crear Barco
</a>

<div class="container">
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var barco in Model)
        {
            var imagenUrl = imagesBarco.ContainsKey(barco.Nombre)
            ? Url.Content(imagesBarco[barco.Nombre])
            : Url.Content("~/images/barco/barco-default.jpg"); // Imagen por defecto

            <div class="col">
                <div class="card shadow-lg border-0 rounded-4 h-100">
                    <img src="@imagenUrl" class="card-img-top" alt="@barco.Nombre" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-uppercase fw-bold text-primary">@barco.Nombre</h5>
                        <p class="card-text">@barco.Descripcion</p>
                        <div class="mt-auto text-center">
                            <a asp-action="Detalle" asp-route-id="@barco.IdBarco" class="btn btn-primary w-100">
                                <i class="bi bi-eye"></i> Ver Detalle
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
