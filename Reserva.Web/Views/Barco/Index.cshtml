@model IEnumerable<Reserva.Application.DTOs.BarcoDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Nuestros barcos</h1>

<div class="row">
    @foreach (var barco in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4 shadow-lg border-0 rounded-4">
                <img src="~/images/barcos/@(barco.IdBarco)-@barco.Nombre" class="card-img-top" alt="@barco.Nombre">
                <div class="card-body">
                    <h5 class="card-title">@barco.Nombre</h5>
                    <p class="card-text">@barco.Descripcion</p>

                    <a asp-action="Detalle" asp-route-id="@barco.IdBarco" class="btn btn-primary">
                        <i class="bi bi-eye"></i> Ver Detalle
                    </a>
                </div>
            </div>
        </div>
    }
</div>
