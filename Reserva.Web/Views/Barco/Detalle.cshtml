@model Reserva.Application.DTOs.BarcoDTO

@{
    ViewData["Title"] = "Detalle del Barco";

    // Asignar imágenes manualmente según el nombre del barco
    var imagesBarco = new Dictionary<string, string>
    {
        { "Mar del Caribe", "~/images/barco/MCaribe.jpg" },
        { "Blue Island", "~/images/barco/blue.jpg" },
        { "Ocean Explorer", "~/images/barco/ocean.jpg" },
        { "Pacific Dream", "~/images/barco/pacific.jpg" },
        { "Atlantis Voyager", "~/images/barco/Atlantis.jpg" }
    };

    var imagenUrl = imagesBarco.ContainsKey(Model.Nombre)
        ? Url.Content(imagesBarco[Model.Nombre])
        : Url.Content("~/images/barco/barco-default.jpg");
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="row g-0">
            <!-- Columna para la imagen del barco -->
            <div class="col-md-5">
                <img src="@imagenUrl" class="img-fluid rounded-start" alt="@Model.Nombre" style="height: 300px; object-fit: cover; width: 100%;">
            </div>

            <!-- Columna para la información del barco -->
            <div class="col-md-7">
                <div class="card-body">
                    <h2 class="card-title text-uppercase fw-bold text-primary">@Model.Nombre</h2>
                    <hr>
                    <p class="card-text"><strong>Descripción:</strong> @Model.Descripcion</p>
                    <p class="card-text">
                        <strong>Capacidad Máxima de Huéspedes:</strong>
                        <span class="fw-bold text-primary">@Model.CapacidadTotalHuespedes</span>
                    </p>
                    <a asp-action="Index" class="btn btn-secondary mt-3">Volver a la Lista</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Habitaciones Disponibles -->
    <div class="card shadow-lg border-0 rounded-4 mt-4">
        <div class="card-body">
            <h4 class="text-center text-uppercase fw-bold text-primary">Habitaciones Disponibles</h4>
            <table class="table table-bordered mt-3">
                <thead class="table-primary">
                    <tr>
                        <th>Tipo de Habitación</th>
                        <th>Cantidad Disponible</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var habitacion in Model.Habitaciones)
                    {
                        <tr>
                            <td>@habitacion.NombreHabitacion</td>
                            <td>@habitacion.CantidadHabitaciones</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
